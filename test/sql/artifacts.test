# name: test/sql/artifacts.test
# description: dbt artifact tables over real dbt-core artifacts (manifest v7-v12), run through DuckDB
# group: [dbt]

require vgi

require-env DBT_WORKER

require-env DBT_FIXTURES

require-env DBT_TEST_DATA

require-env DBT_MOCK_API

statement ok
LOAD json;

statement ok
ATTACH 'dbt' (TYPE vgi, LOCATION '{DBT_WORKER}');

# ------------------------------------------------------------ artifact_info / triage

query TTIT
SELECT schema_version, dbt_version, node_count, support_status
FROM dbt.main.artifact_info('{DBT_FIXTURES}/*/manifest.json') ORDER BY string_split(dbt_version, '.')[2]::INT;
----
v7	1.3.7	22	supported
v8	1.4.9	22	supported
v9	1.5.11	22	supported
v10	1.6.18	23	supported
v11	1.7.19	23	supported
v12	1.12.7	23	supported

query TTT
SELECT artifact_type, schema_version, support_status FROM dbt.main.artifact_info('{DBT_FIXTURES}/v12/*.json') ORDER BY artifact_type;
----
catalog	v1	supported
manifest	v12	supported
run_results	v6	supported
sources	v3	supported

# A newer, unseen manifest version is best_effort with a warning, and still parses.
query TTT
SELECT schema_version, support_status, warning LIKE '%newer than the newest verified%'
FROM dbt.main.artifact_info('{DBT_TEST_DATA}/synthetic/manifest_v13.json');
----
v13	best_effort	true

query TTT
SELECT name, materialized, manifest_version FROM dbt.main.nodes('{DBT_TEST_DATA}/synthetic/manifest_v13.json');
----
orders	table	v13

# Below the window: unsupported, but raw_sql/compiled_sql still map to raw_code/compiled_code.
query TT
SELECT support_status, schema_version FROM dbt.main.artifact_info('{DBT_TEST_DATA}/synthetic/manifest_v5.json');
----
unsupported	v5

query TTT
SELECT name, raw_code, compiled_code FROM dbt.main.nodes('{DBT_TEST_DATA}/synthetic/manifest_v5.json') ORDER BY name;
----
orders	select * from {{ ref('stg') }}	select * from stg
stg	select 1 as id	NULL

query T
SELECT dbt.main.manifest_version('{DBT_FIXTURES}/v9/manifest.json');
----
v9

query I
SELECT count(*) FROM dbt.main.schema_versions WHERE artifact_type = 'manifest' AND supported;
----
6

# ------------------------------------------------------------------------ nodes

query TTI
SELECT manifest_version, resource_type, count(*) FROM dbt.main.nodes('{DBT_FIXTURES}/*/manifest.json')
WHERE manifest_version IN ('v7', 'v12') GROUP BY ALL ORDER BY ALL;
----
v12	model	6
v12	seed	3
v12	snapshot	1
v12	test	13
v7	model	5
v7	seed	3
v7	snapshot	1
v7	test	13

query TI
SELECT materialized, count(*) FROM dbt.main.nodes('{DBT_FIXTURES}/v12/manifest.json')
WHERE resource_type = 'model' GROUP BY ALL ORDER BY ALL;
----
table	3
view	3

# resource_type / package_name filters prune by unique_id before the node is read.
query I
SELECT count(*) FROM dbt.main.nodes('{DBT_FIXTURES}/v12/manifest.json') WHERE resource_type IN ('seed', 'snapshot');
----
4

query I
SELECT count(*) FROM dbt.main.nodes('{DBT_FIXTURES}/v12/manifest.json') WHERE package_name = 'nope';
----
0

# Version-tolerant columns: access / contract arrived in v9; NULL (not an error) before.
query TII
SELECT manifest_version, count(access), count(*) FILTER (WHERE contract_enforced)
FROM dbt.main.nodes('{DBT_FIXTURES}/*/manifest.json') WHERE resource_type = 'model' GROUP BY ALL ORDER BY ALL;
----
v10	6	1
v11	6	1
v12	6	1
v7	0	1
v8	0	1
v9	5	1

query TTTTT
SELECT name, relation_name, db_schema, original_file_path, fqn::VARCHAR
FROM dbt.main.nodes('{DBT_FIXTURES}/v12/manifest.json') WHERE unique_id = 'model.jaffle_shop.orders';
----
orders	"jaffle_shop"."main"."orders"	main	models/marts/orders.sql	[jaffle_shop, marts, orders]

query TT
SELECT typeof(meta), json_extract_string(meta, '$.owner') FROM dbt.main.nodes('{DBT_FIXTURES}/v12/manifest.json') WHERE name = 'customers';
----
JSON	analytics

query T
SELECT compiled_code LIKE '%"jaffle_shop"."main"."stg_orders"%' FROM dbt.main.nodes('{DBT_FIXTURES}/v12/manifest.json') WHERE name = 'orders';
----
true

# ---------------------------------------------------- node_columns / catalog drift

query TITT
SELECT name, ordinal, data_type, description FROM dbt.main.node_columns('{DBT_FIXTURES}/v12/manifest.json')
WHERE unique_id = 'model.jaffle_shop.orders' ORDER BY ordinal;
----
order_id	1	integer	(empty)
customer_id	2	integer	(empty)
order_date	3	date	(empty)
status	4	varchar	(empty)
amount	5	double	(empty)

# raw_orders is both a seed node and a source entry in catalog.json.
query TI
SELECT table_name, count(*) FROM dbt.main.catalog_columns('{DBT_FIXTURES}/v12/catalog.json')
WHERE table_name IN ('orders', 'raw_orders') GROUP BY ALL ORDER BY ALL;
----
orders	5
raw_orders	10

# Contract drift query from the README: declared vs warehouse types agree here.
query I
SELECT count(*) FROM dbt.main.catalog_columns('{DBT_FIXTURES}/v12/catalog.json') c
JOIN dbt.main.node_columns('{DBT_FIXTURES}/v12/manifest.json') d
  ON d.unique_id = c.unique_id AND lower(d.name) = lower(c.column_name)
WHERE d.data_type IS NOT NULL AND lower(d.data_type) <> lower(c.column_type);
----
0

# ------------------------------------------------------------ depends_on / macros

query II
SELECT count(*), count(DISTINCT unique_id) FROM dbt.main.depends_on('{DBT_FIXTURES}/v12/manifest.json');
----
28	23

query TT
SELECT unique_id, depends_on_id FROM dbt.main.depends_on('{DBT_FIXTURES}/v12/manifest.json', kind := 'macros')
WHERE unique_id LIKE 'model.%' ORDER BY ALL;
----
model.jaffle_shop.stg_payments	macro.jaffle_shop.cents_to_dollars

statement error
SELECT * FROM dbt.main.depends_on('{DBT_FIXTURES}/v12/manifest.json', kind := 'columns');
----
<REGEX>:.*

query TT
SELECT name, path FROM dbt.main.macros('{DBT_FIXTURES}/v12/manifest.json') WHERE package_name = 'jaffle_shop';
----
cents_to_dollars	macros/cents_to_dollars.sql

# ----------------------------------------- sources / exposures / groups / semantic

query TTT
SELECT unique_id, loaded_at_field, json_extract_string(freshness, '$.error_after.period')
FROM dbt.main.sources('{DBT_FIXTURES}/v12/manifest.json') WHERE freshness IS NOT NULL;
----
source.jaffle_shop.raw.raw_orders	_loaded_at	hour

query TTTT
SELECT name, exposure_type, owner_email, list_sort(depends_on_ids)::VARCHAR FROM dbt.main.exposures('{DBT_FIXTURES}/v7/manifest.json');
----
weekly_revenue	dashboard	data@example.com	[model.jaffle_shop.customers, model.jaffle_shop.orders]

query TTT
SELECT manifest, name, owner_email FROM (
  SELECT 'v9' AS manifest, * FROM dbt.main.groups('{DBT_FIXTURES}/v9/manifest.json')
  UNION ALL SELECT 'v12', * FROM dbt.main.groups('{DBT_FIXTURES}/v12/manifest.json')) ORDER BY ALL;
----
v12	finance	finance@example.com
v9	finance	finance@example.com

# Groups did not exist before v9: empty, never an error.
query I
SELECT count(*) FROM dbt.main.groups('{DBT_FIXTURES}/v8/manifest.json');
----
0

query TTTI
SELECT name, model_ref, identifier, json_array_length(measures) FROM dbt.main.semantic_models('{DBT_FIXTURES}/v12/manifest.json');
----
orders_sm	ref('orders')	orders	2

query I
SELECT count(*) FROM dbt.main.semantic_models('{DBT_FIXTURES}/v9/manifest.json');
----
0

# Metrics: pre-MetricFlow (v7) calculation_method/expression map onto the same columns.
query TTTTTT
SELECT name, metric_type, expression, filter_expression, agg, agg_time_dimension FROM dbt.main.metrics('{DBT_FIXTURES}/v7/manifest.json') ORDER BY name;
----
completed_orders	count	order_id	status = 'completed'	count	order_date
revenue	sum	amount	NULL	sum	order_date

query TTTT
SELECT name, metric_type, expression, filter_expression FROM dbt.main.metrics('{DBT_FIXTURES}/v12/manifest.json') ORDER BY name;
----
completed_orders	simple	order_count	{{ Dimension('order__status') }} = 'completed'
revenue	simple	order_total	NULL

query TT
SELECT name, filter_expression FROM dbt.main.metrics('{DBT_FIXTURES}/v10/manifest.json') WHERE filter_expression IS NOT NULL;
----
completed_orders	{{ Dimension('order__status') }} = 'completed'

# ------------------------------------------------ run_results / timings / freshness

query TI
SELECT status, count(*) FROM dbt.main.run_results('{DBT_FIXTURES}/v12/run_results.json') GROUP BY ALL ORDER BY ALL;
----
fail	1
no-op	1
pass	11
success	10
warn	1

query TI
SELECT unique_id, failures FROM dbt.main.run_results('{DBT_FIXTURES}/v12/run_results.json') WHERE status IN ('fail', 'warn') ORDER BY ALL;
----
test.jaffle_shop.accepted_values_stg_payments_payment_method__credit_card__coupon__bank_transfer.1a6bf817f5	1
test.jaffle_shop.relationships_orders_customer_id__customer_id__ref_customers_.c6ec7f58f2	4

# A glob is one partition per file: six archived runs.
query II
SELECT count(DISTINCT artifact_path), count(DISTINCT invocation_id) FROM dbt.main.run_results('{DBT_FIXTURES}/*/run_results.json');
----
6	6

query T
SELECT bool_and(execute_completed >= compile_started) FROM dbt.main.run_results('{DBT_FIXTURES}/*/run_results.json') WHERE status = 'success';
----
true

query TIT
SELECT name, count(*), bool_and(duration_seconds >= 0) FROM dbt.main.run_timings('{DBT_FIXTURES}/v12/run_results.json') GROUP BY ALL ORDER BY ALL;
----
compile	24	true
execute	24	true

query TTT
SELECT unique_id, status, age_seconds > 86400 FROM dbt.main.source_freshness('{DBT_FIXTURES}/v12/sources.json');
----
source.jaffle_shop.raw.raw_orders	error	true

# ----------------------------------------------------------------- remote paths

query I
SELECT count(*) FROM dbt.main.nodes('{DBT_MOCK_API}/files/v12/manifest.json') WHERE resource_type = 'model';
----
6

# ------------------------------------------------------------------------ errors

statement error
SELECT * FROM dbt.main.nodes('{DBT_FIXTURES}/does-not-exist.json');
----
artifact not found

statement error
SELECT * FROM dbt.main.nodes('{DBT_FIXTURES}/v12/run_results.json');
----
is a run_results artifact, but this function reads manifest.json

statement error
SELECT * FROM dbt.main.nodes('{DBT_FIXTURES}/v12');
----
is a directory

statement error
SELECT * FROM dbt.main.nodes('{DBT_TEST_DATA}/synthetic/truncated.json');
----
malformed dbt artifact

statement error
SELECT * FROM dbt.main.nodes('{DBT_TEST_DATA}/synthetic/not_dbt.json');
----
not a dbt artifact

statement error
SELECT * FROM dbt.main.nodes('s3://bucket/manifest.json');
----
object-store URLs are not read directly

statement error
SELECT * FROM dbt.main.nodes('');
----
artifact path is empty

query I
SELECT count(*) FROM dbt.main.run_results('{DBT_FIXTURES}/no-such-dir/**/run_results.json');
----
0
